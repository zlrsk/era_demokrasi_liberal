@parliament
on-display: {!
data = Q.parliament_diagram;
if (d3 && window && Q.started) {
    var data = Q.parliament_diagram;
    var screenWidth = document.getElementById('qualities').offsetWidth;

    var width = Math.max(Math.min(screenWidth , 250), 120);
    var heightRatio = screenWidth < 350 ? 0.5 : 0.6;
    var height = width * heightRatio;

    document.getElementById("reichstag_st").style.height = height + "px";

    var reichstag_st = d3.parliament();
    reichstag_st.width(width)
    reichstag_st.height(height)
    reichstag_st.innerRadiusCoef(0.4)
    reichstag_st.enter.fromCenter(false).smallToBig(false)
    reichstag_st.exit.toCenter(false).bigToSmall(false);
    d3.select("#reichstag_st").datum(data).call(reichstag_st);
}
!}

= Parliament

<div style="text-align: center;">Speaker: [+ dprs_speaker +] ([? if dprs_speaker_party == "Masyumi":<span style="color: #000000;">**M**</span>?][? if dprs_speaker_party == "PNI":<span style="color: #990000;">**PNI**</span>?])</div>
[? if dprs_speaker == "Sartono": <div><img src="img/portraits/sartono.jpg" alt="Sartono" style="width: 50%;display: block;margin: auto;margin-bottom: 5px;border: 5px solid var(--card-border-color);"></div> ?]

<div>{!<svg id="reichstag_st" style="width: 550px; height: 275px;"> </svg>!}</div>

{!<table>!} 
{!<tr><td>Party</td><td>% of Seats</td><td>Status</td></tr>!}
