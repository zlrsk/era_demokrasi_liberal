title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.santri_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}


= <span style="color: #990000;">**PNI**</span> Leadership

<div style="text-align: center;">Chairman</div>
[? if pni_leader == "Sidik Djojosukarto": <div><img src="img/portraits/sidik.jpg" alt="Sidik Djojosukarto" style="width: 50%;display: block;margin-top: 5px;margin: auto;margin-bottom: 5px;border: 5px solid var(--card-border-color);"></div> ?]
<div style="text-align: center;">**[+ pni_leader +]**</div>

Deputy Chairman: 
<div style="text-align: left;margin-top: -15px;">[+ vice_chair +]</div>

General Secretary: 
<div style="text-align: left;margin-top: -15px;">[+ gensec +]</div>

Next Congress: [+ next_congress_month +] [+ next_congress_year +]

= Status


Resources available: [+ resources +]

Party dues: [+ dues +]

<span style="color: #990000;">**PNI**</span> position: [? if PNI_toleration : toleration ?][? if PNI_in_government : in government - ?][? if PNI_toleration == 0 and PNI_in_government == 0 and PNI_caretaker == 0 : opposition ?][? if PNI_caretaker : caretaker government ?]
[? if in_weimar_coalition and PNI_in_government: Weimar Coalition ?][? if in_grand_coalition and PNI_in_government: Grand Coalition ?][? if in_popular_front and PNI_in_government: Popular Front ?][? if in_left_front and PNI_in_government: Left Front ?][? if in_pni_majority and PNI_in_government: PNI majority ?][? if in_minority_government and PNI_in_government: minority government ?][? if in_emergency_government and PNI_in_government: emergency government ?]

[? if PNI_in_government and not in_pni_majority and not in_left_front : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

[? if PNI_in_government and (in_left_front or in_popular_front): PKI coalition dissent: [+ PKI_coalition_dissent : coalition_dissent +] ?]

= Internal Factions of the <span style="color: #990000;">**PNI**</span>

Internal dissent: [+ dissent_percent : dissent +]

{!<span class="tooltip-text" title="Wilopo's faction mostly consists of moderate, younger figures of the party.">Wilopo Group</span>!} (<span style="color: #ff6d50;">**Moderates**</span>) 
<div style="text-align: left;margin-top: -15px;">Strength: [+ wilopo_strength : strength +]</div>
<div style="text-align: left;margin-top: 0px;">Dissent: [+ wilopo_dissent : dissent +]</div>

{!<span class="tooltip-text" title="Sidik Djojosukarto and his clique pushes the party to a pro-labor and socialist stance.">Sidik Group</span>!} (<span style="color: #e90000;">**Leftists**</span>) 
<div style="text-align: left;margin-top: -15px;">Strength: [+ sidik_strength : strength +]</div>
<div style="text-align: left;margin-top: 0px;">Dissent: [+ sidik_dissent : dissent +]</div>

{!<span class="tooltip-text" title="The Sartono-Suwirjo group are mostly administrators and bureaucrats who are more radical in their nationalism.">Sartono-Suwirjo Group</span>!} (<span style="color: #7c0000;">**Radicals**</span>) 
<div style="text-align: left;margin-top: -15px;">Strength: [+ partindo_strength : strength +]</div>
<div style="text-align: left;margin-top: 0px;">Dissent: [+ partindo_dissent : dissent +]</div>

= Economics

Inflation: [+ inflation_2 +]%

[? if black_thursday_seen = 1 : Unemployment: [+ santri_2 +]% ?]

Economic growth: [+ economic_growth_2 +]%

@politics

= Inter-party Relations

<img src="img/icons/masjumi.png" style="height: 10px;"> {!<span class="tooltip-text" title="Council of Indonesian Muslim Associations Party" style="color: #000000;"><strong>Masjumi</strong></span>!}: [+ masyumi_relation : relationships +]

<img src="img/icons/PSI.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Socialist Party" style="color: #FF6666;"><strong>PSI</strong></span>!}: [+ psi_relation : relationships +]

<img src="img/icons/PSII.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Islamic Union Party" style="color: #003319;"><strong>PSII</strong></span>!}: [+ psii_relation : relationships +]

<img src="img/icons/PKI.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Communist Party" style="color: #c00000;"><strong>PKI</strong></span>!}: [+ pki_relation : relationships +]

<img src="img/icons/kristen.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Christian Party (Protestant)" style="color: #66B2FF;"><strong>Parkindo</strong></span>!}: [+ kristen_relation : relationships +]

<img src="img/icons/katolik.png" style="height: 10px;"> {!<span class="tooltip-text" title="Catholic Party" style="color: #330000;"><strong>Katolik</strong></span>!}: [+ katolik_relation : relationships +]

<img src="img/icons/PIR.png" style="height: 10px;"> {!<span class="tooltip-text" title="Greater Indonesia Union Party" style="color: #FF9933;"><strong>PIR</strong></span>!}: [+ pir_relation : relationships +]

<img src="img/icons/PRN.png" style="height: 10px;"> {!<span class="tooltip-text" title="National People's Party" style="color: #545454;"><strong>PRN</strong></span>!}: [+ prn_relation : relationships +]

<img src="img/icons/murba.png" style="height: 10px;"> {!<span class="tooltip-text" title="Proletarian Party" style="color: #ff3333;"><strong>Murba</strong></span>!}: [+ murba_relation : relationships +]

=Party Leadership

<img src="img/icons/PNI.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian National Party" style="color: #990000;"><strong>PNI</strong></span>!}: [+ pni_leader +] (Marhaenism)

<img src="img/icons/masjumi.png" style="height: 10px;"> {!<span class="tooltip-text" title="Council of Indonesian Muslim Associations Party" style="color: #000000;"><strong>Masjumi</strong></span>!}: [+ masyumi_leader +] ([+ masyumi_ideology1 +])

<img src="img/icons/PSI.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Socialist Party" style="color: #FF6666;"><strong>PSI</strong></span>!}: Sutan Sjahrir (Popular Socialism)

<img src="img/icons/PSII.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Islamic Union Party" style="color: #003319;"><strong>PSII</strong></span>!}: Anwar Tjokroaminoto (Islamic Democracy)

<img src="img/icons/PKI.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Communist Party" style="color: #c00000;"><strong>PKI</strong></span>!}: [+ pki_leader +] ([+ pki_ideology +])

<img src="img/icons/kristen.png" style="height: 10px;"> {!<span class="tooltip-text" title="Indonesian Christian Party (Protestant)" style="color: #66B2FF;"><strong>Parkindo</strong></span>!}: Johannes Leimena (Christian Democracy)

<img src="img/icons/katolik.png" style="height: 10px;"> {!<span class="tooltip-text" title="Catholic Party" style="color: #330000;"><strong>Katolik</strong></span>!}: I. J. Kasimo (Catholic Democracy)

<img src="img/icons/PIR.png" style="height: 10px;"> {!<span class="tooltip-text" title="Greater Indonesia Union Party" style="color: #FF9933;"><strong>PIR</strong></span>!}: Wongsonegoro (Nationalism)

<img src="img/icons/PRN.png" style="height: 10px;"> {!<span class="tooltip-text" title="National People's Party" style="color: #545454;"><strong>PRN</strong></span>!}: Djody Gondokusumo (Right-wing Nationalism)

<img src="img/icons/murba.png" style="height: 10px;"> {!<span class="tooltip-text" title="Proletarian Party" style="color: #ff3333;"><strong>Murba</strong></span>!}: Sukarni (Tan Malaka Thought)

@polls
on-arrival: {!
Q.pro_republic_disp = Math.round(Q.pro_republic);
Q.nationalism_disp = Math.round(Q.nationalism);
Q.socialism_disp = Math.round(Q.socialism);
!}

