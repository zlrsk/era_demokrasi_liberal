@parliament
on-arrival: {!
Q.pni_seats = Math.round(Q.pni_r*2.32);
Q.pki_seats = Math.round(Q.pki_r*2.32);
Q.murba_seats = Math.round(Q.murba_r*2.32);
Q.psi_seats = Math.round(Q.psi_r*2.32);
Q.pir_seats = Math.round(Q.pir_r*2.32);
Q.prn_seats = Math.round(Q.prn_r*2.32);
Q.kristen_seats = Math.round(Q.kristen_r*2.32);
Q.katolik_seats = Math.round(Q.katolik_r*2.32);
Q.psii_seats = Math.round(Q.psii_r*2.32);
Q.masyumi_seats = Math.round(Q.masyumi_r*2.32);
!}
on-display: {!
data = Q.parliament_diagram;
if (d3 && window && Q.started) {
    var data = Q.parliament_diagram;
    var screenWidth = document.getElementById('qualities').offsetWidth;

    var width = Math.max(Math.min(screenWidth , 250), 120);
    var heightRatio = screenWidth < 350 ? 0.5 : 0.6;
    var height = width * heightRatio;

    document.getElementById("reichstag_st").style.height = height + "px";

    var reichstag_st = d3.parliament();
    reichstag_st.width(width)
    reichstag_st.height(height)
    reichstag_st.innerRadiusCoef(0.4)
    reichstag_st.enter.fromCenter(false).smallToBig(false)
    reichstag_st.exit.toCenter(false).bigToSmall(false);
    d3.select("#reichstag_st").datum(data).call(reichstag_st);
}
!}

= Parliament

[? if dprs_speaker == "Sartono": <div><img src="img/portraits/sartono.jpg" alt="Sartono" style="width: 50%;display: block;margin: auto;margin-top: 5px;margin-bottom: 5px;border: 5px solid var(--card-border-color);"></div> ?]
<div style="text-align: center;">**[+ dprs_speaker +]** ([? if dprs_speaker_party == "Masyumi":<span style="color: #000000;">**M**</span>?][? if dprs_speaker_party == "PNI":<span style="color: #990000;">**PNI**</span>?])</div>
<div style="text-align: center;color: var(--unavailable-color);font-size: 0.8em;">*Speaker*</div>

<div>{!<svg id="reichstag_st" style="display: block;width: 150%;"> </svg>!}</div>
<div style="text-align: center;margin-top: 5px;">**Dewan Perwakilan Rakyat [? if election_held == 0: Sementara?]**</div>
<div style="text-align: center;color: var(--unavailable-color);font-size: 0.8em;">*[? if election_held == 0: Provisional?] House of Representatives*</div>

{!<table>!} 
{!<tr><td>Party</td><td>Seats</td><td>Status</td></tr>!}
{!<tr><td><div class="box" style='background-color:#990000; outline: 2px; outline-style: solid;'> </div> !} **PNI:** {!</td><td>!} **[+ pni_seats +] ([+ pni_r +]%)** {!</td><td>!} [? if pni_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if pni_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#c00000'> </div> !} PKI: {!</td><td>!} [+ pki_seats +] ([+ pki_r +]%) {!</td><td>!} [? if pki_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if pki_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FF3333'> </div> !} Murba: {!</td><td>!} [+ murba_seats +] ([+ murba_r +]%) {!</td><td>!} [? if murba_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if murba_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FF6666'> </div> !} PSI: {!</td><td>!} [+ psi_seats +] ([+ psi_r +]%) {!</td><td>!} [? if psi_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if psi_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FF9933'> </div> !} PIR: {!</td><td>!} [+ pir_seats +] ([+ pir_r +]%) {!</td><td>!} [? if pir_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if pir_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#545454'> </div> !} PRN: {!</td><td>!} [+ prn_seats +] ([+ prn_r +]%) {!</td><td>!} [? if prn_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if prn_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#66B2FF'> </div> !} Parkindo: {!</td><td>!} [+ kristen_seats +] ([+ kristen_r +]%) {!</td><td>!} [? if kristen_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if kristen_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#330000'> </div> !} Katolik: {!</td><td>!} [+ katolik_seats +] ([+ katolik_r +]%) {!</td><td>!} [? if katolik_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if katolik_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#003319'> </div> !} PSII: {!</td><td>!} [+ psii_seats +] ([+ psii_r +]%) {!</td><td>!} [? if psii_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if psii_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#000'> </div> !} Masjumi: {!</td><td>!} [+ masyumi_seats +] ([+ masyumi_r +]%) {!</td><td>!} [? if masyumi_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if masyumi_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}
{!</table>!}