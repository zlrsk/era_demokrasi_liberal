@start_menu_2

- @start: Start game
- @election_simulation: Election simulation
- @credits: Credits
- @game_over.achievements


@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1951;
Q.month = 0;
// how many actions have been taken this month?
Q.month_actions = 0;
Q.leverage = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.old_demographics = 0;
// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

// party resources
Q.resources = 2;
// party dues
Q.dues = 2;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
Q.factions = ['wilopo', 'sidik', 'partindo'];
// should this be normalized to 100%?
Q.wilopo_strength = 20;
Q.wilopo_dissent = 10;
Q.sidik_strength = 30;
Q.sidik_dissent = 0;
Q.partindo_strength = 25;
Q.partindo_dissent = 5;

// secret events...
Q.unions_independent = 0;
Q.centrists_resign = 0;
Q.wilopo_split = 0;
Q.partindos_resigned = 0;

// have we discovered neorevisionism?
Q.neorevisionism = 0;

// crisis_urgency indicates how seriously the pni is taking the economic crisis - scale from 0 to 10.
Q.crisis_urgency = 0;
// namasyumii_urgency indicates how seriously the pni takes the namasyumiis - scale from 0 to 10.
Q.namasyumii_urgency = 0;
// radicalimasyumiation indicates how radical the pni's rhetoric is - scale from 0 to 10.
Q.radicalimasyumiation = 0;
// Support for the WTB plan and proto-Keynesian works creation plans in general
Q.wtb_support = 0;
// Support for Pacifism within the pni relative to 1928
Q.pacifism = 0;
// Support for democratic reform within the pni relative to 1928
Q.democratimasyumiation = 0;
// Support for a communist coalition relative to 1928
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - WTB plan, 2 - AfA-bund plan, 3 - radical plan (mass nationalimasyumiation of industries)
Q.economic_plan = 0;
// have we officially adopted the WTB plan?
Q.wtb_adopted = 0;
// have we formed the iron front?
Q.iron_front_formed = 0;
// people's party support
Q.peoples_party_support = 0;
